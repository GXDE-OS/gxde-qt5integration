# Maintainer: CharOfString <root@charofstring.cc>
pkgname=gxde-qt5integration-git
pkgver=0.3.12
pkgrel=2
pkgdesc='Qt5 style plugin for GXDE DTK2 applications'
arch=('x86_64' 'aarch64')
url="https://github.com/GXDE-OS/gxde-qt5integration"
license=('GPL-3.0-or-later')
depends=('dtkwidget2-git' 'qt5-base' 'libgcc' 'libstdc++' 'glibc')
# DTK5 的平台主题插件尚未进入 GXDE Arch 源，官方源的版本对应的 DTK 版本不同
# The DTK5 platform theme is not in the GXDE Arch repo yet, and the one in
# the official repos is built against a different DTK.
optdepends=('deepin-qt5integration-git: DTK5 platform theme for GXDE')
makedepends=('git' 'dtkwidget2-dev-git')
provides=("gxde-qt5integration=$pkgver")
conflicts=('gxde-qt5integration')
source=()
sha512sums=()

# 直接使用 PKGBUILD 所在的 git 仓库作为源码 ・ Build from the git checkout this PKGBUILD lives in.
_srcroot() {
  git -C "$startdir" rev-parse --show-toplevel
}

build() {
  mkdir -p build
  cd build
  qmake-qt5 -r "$(_srcroot)" \
    QMAKE_CFLAGS_RELEASE="$CFLAGS" \
    QMAKE_CXXFLAGS_RELEASE="$CXXFLAGS" \
    QMAKE_LFLAGS_RELEASE="$LDFLAGS"
  make
}

package() {
  make -C build INSTALL_ROOT="$pkgdir" install
}
